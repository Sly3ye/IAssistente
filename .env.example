# Runtime environment: development | staging | production
APP_ENV=development
ALLOW_CLIENT_SIDE_LLM_IN_PRODUCTION=false
DEV_BYPASS_AUTH=false

# Preferred secure setup: configure only the backend proxy URL
# and keep provider keys on server-side.
LLM_PROXY_URL=http://localhost:8787/v1/chat
LLM_PROXY_PROVIDER=openai
LLM_PROXY_AUTH_TOKEN=

# Local direct-provider fallback (development only)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama endpoint:
# - Android emulator: http://10.0.2.2:11434/api/chat
# - Physical Android device: http://<YOUR-PC-LAN-IP>:11434/api/chat
OLLAMA_BASE_URL=

# AdMob app IDs and unit IDs. Leave empty in development to use test IDs.
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
ADMOB_REWARDED_ANDROID=
ADMOB_REWARDED_IOS=

# Store product IDs for premium offers.
IAP_PREMIUM_MONTHLY=
IAP_PREMIUM_YEARLY=
IAP_PREMIUM_LIFETIME=
